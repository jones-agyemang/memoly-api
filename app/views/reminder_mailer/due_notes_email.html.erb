<% content_for :head do %>
  <%= stylesheet_link_tag "mailer", media: "all" %>
<% end %>

<% app_url = ENV.fetch("APP_URL") %>
<% logo_url = ENV.fetch("MEMOLY_LOGO_URL", "https://memoly.io/logo.png") %>

<div class="reminder-email" style="margin: 0; padding: 16px 8px; background-color: #f7f8fc; color: #111d3f; font-family: Arial, Helvetica, sans-serif;">
  <table class="email-shell" role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width: 100%; max-width: 680px; margin: 0 auto; overflow: hidden; background-color: #ffffff; border-radius: 22px; box-shadow: 0 8px 30px rgba(17, 29, 63, 0.08);">
    <tr>
      <td class="brand-header" style="padding: 44px 40px 40px; background-color: #f0f3ff;">
        <img src="<%= logo_url %>" width="225" alt="Memoly" style="display: block; width: 225px; max-width: 70%; height: auto; border: 0;">
      </td>
    </tr>

    <tr>
      <td class="email-content" style="padding: 54px 38px 48px;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
          <tr>
            <td class="hero-copy" style="vertical-align: middle;">
              <h1 style="margin: 0; color: #111d3f; font-size: 44px; line-height: 1.1; font-weight: 700; letter-spacing: -1.2px; text-align: left;">Review your<br>latest notes</h1>
            </td>
            <td class="hero-art-cell" width="190" style="width: 190px; vertical-align: middle; text-align: center;">
              <div class="hero-art" aria-hidden="true" style="display: inline-block; width: 150px; height: 150px; border-radius: 75px; background-color: #f0f3ff; text-align: center; line-height: 150px; font-size: 76px;">📖</div>
            </td>
          </tr>
        </table>

        <div class="due-summary" aria-label="You have <%= @notes.count %> <%= "note".pluralize(@notes.count) %> due Today." style="max-width: 455px; margin: 34px auto 0; padding: 16px 24px; border-radius: 12px; background-color: #f6f7fc; color: #101936; font-size: 24px; line-height: 1.35; text-align: center;">
          You have <strong style="color: #2937c7; font-weight: 700;"><%= @notes.count %></strong> <%= "note".pluralize(@notes.count) %> due Today.
        </div>

        <div class="primary-action" style="padding-top: 34px; text-align: center;">
          <%= link_to "Review them here  →", "#{app_url}review-notes", class: "primary-button", style: "display: inline-block; min-width: 300px; padding: 18px 28px; border-radius: 9px; background-color: #303bc3; color: #ffffff; font-size: 24px; line-height: 1.2; font-weight: 600; text-align: center; text-decoration: none; box-shadow: 0 2px 5px rgba(37, 49, 181, 0.2);" %>
        </div>

        <table class="quote-divider" role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top: 54px;">
          <tr>
            <td style="border-top: 2px solid #dfe3f7; font-size: 1px; line-height: 1px;">&nbsp;</td>
            <td width="92" style="width: 92px; text-align: center;">
              <span style="display: inline-block; width: 62px; height: 62px; border-radius: 31px; background-color: #f0f3ff; color: #303bc3; font-family: Georgia, serif; font-size: 46px; line-height: 78px; font-weight: 700; text-align: center;">&ldquo;</span>
            </td>
            <td style="border-top: 2px solid #dfe3f7; font-size: 1px; line-height: 1px;">&nbsp;</td>
          </tr>
        </table>

        <div class="quote-block" style="padding: 26px 24px 0; text-align: center;">
          <blockquote style="margin: 0; color: #101936; font-size: 23px; line-height: 1.45; font-weight: 400;">
            Words can be like X-rays, if you use them properly—they’ll go through anything. You read and you’re pierced.
          </blockquote>
          <p class="quote-source" style="margin: 24px 0 0; color: #303bc3; font-size: 21px; line-height: 1.4;">Aldous Huxley, <cite>Brave New World</cite></p>
        </div>

        <div class="secondary-action" style="padding-top: 36px; text-align: center;">
          <%= link_to app_url, class: "secondary-button", style: "display: block; padding: 24px 26px; border: 2px solid #6672df; border-radius: 10px; color: #2636bd; font-size: 23px; line-height: 1.3; font-weight: 600; text-align: center; text-decoration: none;" do %>
            Jump back into your notes
          <% end %>
        </div>
      </td>
    </tr>
  </table>
</div>
