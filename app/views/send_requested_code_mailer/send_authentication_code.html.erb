<% content_for :head do %>
  <%= stylesheet_link_tag "mailer", media: "all" %>
<% end %>

<% app_url = ENV.fetch("APP_URL", "https://memoly.io/") %>
<% logo_url = ENV.fetch("MEMOLY_LOGO_URL", "https://memoly.io/logo.png") %>
<% authentication_code = @user.authentication_code %>

<div class="memoly-email authentication-email" style="margin: 0; padding: 16px 8px; background-color: #f7f8fc; color: #111d3f; font-family: Arial, Helvetica, sans-serif;">
  <table class="email-shell" role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width: 100%; max-width: 680px; margin: 0 auto; overflow: hidden; background-color: #ffffff; border-radius: 22px; box-shadow: 0 8px 30px rgba(17, 29, 63, 0.08);">
    <tr>
      <td class="brand-header" style="padding: 44px 40px 40px; background-color: #f0f3ff;">
        <img src="<%= logo_url %>" width="225" alt="Memoly" style="display: block; width: 225px; max-width: 70%; height: auto; border: 0;">
      </td>
    </tr>

    <tr>
      <td class="email-content" style="padding: 54px 38px 48px;">
        <p class="auth-intro" style="margin: 38px auto 0; max-width: 520px; color: #3f4966; font-size: 20px; line-height: 1.5; text-align: center;">
          Use the secure code below to finish signing in to Memoly.
        </p>

        <div class="code-panel" style="margin: 30px auto 0; max-width: 455px; padding: 28px 24px; border: 2px solid #dfe3f7; border-radius: 14px; background-color: #f6f7fc; text-align: center;">
          <p style="margin: 0; color: #69728c; font-size: 14px; line-height: 1.3; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase;">Your access code</p>
          <p class="authentication-code" style="margin: 14px 0 0; color: #437bc9; font-family: 'Courier New', Courier, monospace; font-size: 42px; line-height: 1.15; font-weight: 700; letter-spacing: 7px;"><%= authentication_code.code %></p>

          <div class="expiry-notice" style="margin-top: 30px; padding: 22px 24px; border-radius: 12px; color: #2636bd; font-size: 18px; line-height: 1.5; text-align: center;">
            <strong style="display: block; margin-bottom: 5px; color: #111d3f; font-size: 19px;">This code expires in 15 minutes</strong>
            <p style="color: #437bc9;">It will no longer be valid after <%= authentication_code.expires_at.to_fs(:long) %>.</p>
          </div>
        </div>

        <table class="security-note" role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top: 42px;">
          <tr>
            <td style="color: #59627c; font-size: 16px; line-height: 1.55; text-align: center;">
              If you didn’t request this code, you can safely ignore this email. Never share your authentication code with anyone.
            </td>
          </tr>
        </table>

        <div class="secondary-action" style="padding-top: 38px; text-align: center;">
          <%= link_to "Return to Memoly", app_url, class: "secondary-button", style: "display: block; padding: 22px 26px; border: 2px solid #6672df; border-radius: 10px; color: #2636bd; font-size: 22px; line-height: 1.3; font-weight: 600; text-align: center; text-decoration: none;" %>
        </div>

        <p class="copyright" style="margin: 34px 0 0; color: #8b93a9; font-size: 13px; line-height: 1.5; text-align: center;">
          &copy; <%= Time.current.year %> Memoly. All rights reserved.
        </p>
      </td>
    </tr>
  </table>
</div>
